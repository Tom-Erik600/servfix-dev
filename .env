# ============================================================
# LOKAL UTVIKLING ONLY — denne filen lastes IKKE i Cloud Run
# ============================================================
# Cloud Run setter K_SERVICE automatisk, og src/config/database.js
# skipper dotenv.config() når den finnes. Alle env-vars i prod/dev/test
# kommer fra Cloud Run service config + Secret Manager.
#
# Hemmeligheter her må holdes synkronisert med Secret Manager:
#   - DB_PASSWORD       → secret: db-password
#   - SESSION_SECRET    → secret: session-secret
#   - CONSUMER_TOKEN    → secret: tripletex-consumer-token
#   - EMPLOYEE_TOKEN    → secret: tripletex-employee-token
#   - SMTP_PASS         → secret: smtp-password
#
# DB-tilkobling lokalt: Cloud SQL Proxy på port 5434 (dev) / 5435 (test)
# Kommenter ut CLOUD_SQL_CONNECTION_NAME for å bruke localhost-proxyen!
# ============================================================


# Database
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=DevSF1
DB_NAME=servfix_admin

# Cloud SQL (for test-miljø)
# CLOUD_SQL_CONNECTION_NAME=servfix-test:europe-north1:servfix-test-db

# Session
SESSION_SECRET=A0UIX98KL56B33

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=servfix-dev
GCS_BUCKET_NAME=servfix-files-dev
GOOGLE_CLOUD_KEY_FILE=./config/gcp/servfix-storage-key.json

# App
PORT=3000
NODE_ENV=staging

# Tripletex connection
BASE_URL=https://api-test.tripletex.tech/v2
CONSUMER_TOKEN=eyJ0b2tlbklkIjo2MzIsInRva2VuIjoidGVzdC02MDMwMzEwZi1hMzFlLTRhMmQtOTVjOC04MjQzYmY3Mzg5ZTgifQ==
EMPLOYEE_TOKEN=eyJ0b2tlbklkIjo5NDEsInRva2VuIjoidGVzdC05NGNkNDU3YS1hMGZkLTQ3NDMtYWQyZi1hNTk2NjJmM2E3Y2IifQ==

